{
  "name": "event-timeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canvas-based timeline React library (monorepo root).",
  "license": "MIT",
  "author": "Karl Gorgoglione",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarlGorgoglione/event-timeline.git"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "dev": "pnpm --filter demo run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "docs:api": "typedoc",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "size-limit": "^11.1.6",
    "typedoc": "0.28.19",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  }
}
