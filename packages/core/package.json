{
  "name": "@event-timeline/core",
  "version": "0.4.0",
  "description": "Framework-agnostic Canvas timeline engine (pure TypeScript).",
  "license": "MIT",
  "author": "Karl Gorgoglione",
  "homepage": "https://github.com/KarlGorgoglione/event-timeline/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarlGorgoglione/event-timeline.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/KarlGorgoglione/event-timeline/issues"
  },
  "keywords": [
    "timeline",
    "canvas",
    "visualization",
    "events",
    "graph",
    "gantt",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "date-fns": "^4.4.0"
  }
}
