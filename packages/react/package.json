{
  "name": "@event-timeline/react",
  "version": "0.5.0",
  "description": "React binding for the Canvas timeline engine.",
  "license": "MIT",
  "author": "Karl Gorgoglione",
  "homepage": "https://github.com/KarlGorgoglione/event-timeline/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarlGorgoglione/event-timeline.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/KarlGorgoglione/event-timeline/issues"
  },
  "keywords": [
    "timeline",
    "canvas",
    "react",
    "visualization",
    "events",
    "graph",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@event-timeline/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
